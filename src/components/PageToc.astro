---
interface Item {
  id: string;
  title: string;
}

interface Props {
  label: string;
  items: Item[];
}

const { label, items } = Astro.props;
---

<nav class="page-toc" aria-label={label}>
  <details class="page-toc__details">
    <summary>{label}</summary>
    <ol>
      {items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.title}</a>
        </li>
      ))}
    </ol>
  </details>
</nav>

<script>
  const details = document.querySelector<HTMLDetailsElement>('.page-toc__details');
  const summary = details?.querySelector('summary');
  const wide = window.matchMedia('(min-width: 64rem)');

  const sync = () => {
    if (!details) return;
    details.open = wide.matches;
  };

  if (details && summary) {
    summary.addEventListener('click', (event) => {
      if (wide.matches) event.preventDefault();
    });
    wide.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .page-toc {
    font-size: var(--step--1);
  }

  .page-toc__details {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background-color: var(--color-surface);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-s);
    font-weight: 700;
    cursor: pointer;
  }

  ol {
    display: grid;
    padding: 0 var(--space-s) var(--space-s);
    list-style: none;
  }

  li a {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  li a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  @media (min-width: 64rem) {
    .page-toc {
      position: sticky;
      top: var(--space-m);
    }

    .page-toc__details {
      border: 0;
      border-inline-start: 3px solid var(--color-wood);
      border-radius: 0;
      background-color: transparent;
    }

    summary {
      cursor: default;
      list-style: none;
      font-family: var(--font-display);
      font-size: var(--step-0);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    ol {
      padding-block-end: 0;
    }
  }
</style>
